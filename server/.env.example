# Copy to .env and adjust.
PORT=8787
# Secret for signing JWTs. CHANGE THIS in any real deployment.
JWT_SECRET=dev-secret-change-me

# Storage: set DATABASE_URL to use Postgres. If empty, falls back to data.json.
# Matches docker-compose.yml in this folder.
DATABASE_URL=postgres://crypto:crypto@localhost:5432/cryptotracker
