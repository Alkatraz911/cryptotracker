# Copy to .env and adjust.
PORT=8787
# Secret for signing JWTs. CHANGE THIS in any real deployment.
JWT_SECRET=dev-secret-change-me

# Storage: set DATABASE_URL to use Postgres. If empty, falls back to data.json.
# Matches docker-compose.yml in this folder.
DATABASE_URL=postgres://crypto:crypto@localhost:5432/cryptotracker

# Enables auto-enrichment of pasted links and wallet-history loading.
# One Etherscan key covers ETH/BSC/Polygon/Arbitrum/Base (v2 multichain).
ETHERSCAN_API_KEY=
# Tronscan works without a key for low volume.
TRONSCAN_API_KEY=
