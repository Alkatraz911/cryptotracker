PORT=8787
JWT_SECRET=dev-secret-change-me
DATABASE_URL=postgres://crypto:crypto@localhost:5432/cryptotracker
# Comma-separated emails granted the admin role (bridge registry + user management).
# Effective immediately on next request — no DB edit needed for the first admin.
ADMIN_EMAILS=
ETHERSCAN_API_KEY=
TRONSCAN_API_KEY=
SOLSCAN_API_KEY=
# Helius (Solana) — free key at https://dashboard.helius.dev (parsed wallet history + RPC)
HELIUS_API_KEY=
# Local orbiter-indexer service (cross-chain bridge data). Empty = query Orbiter API directly.
ORBITER_INDEXER_URL=http://localhost:8088
# AI assistant (fund-flow analysis). Pluggable engine, chosen entirely via env.
#   AI_PROVIDER  ollama | claude | openrouter | openai   (default: ollama)
#   AI_MODEL     model id (required for openrouter/openai; default: llama3.1 / claude-opus-4-8)
#   OLLAMA_URL   http://localhost:11434       (local model endpoint)
#   ANTHROPIC_API_KEY                         (required when AI_PROVIDER=claude)
AI_PROVIDER=ollama
AI_MODEL=
OLLAMA_URL=http://localhost:11434
ANTHROPIC_API_KEY=
# OpenRouter (AI_PROVIDER=openrouter): set a namespaced AI_MODEL, e.g.
#   AI_MODEL=anthropic/claude-3.5-sonnet  or  meta-llama/llama-3.1-70b-instruct
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1
# Generic OpenAI-compatible server (AI_PROVIDER=openai): LM Studio, vLLM, Together…
OPENAI_BASE_URL=
OPENAI_API_KEY=
