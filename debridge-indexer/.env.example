# HTTP port for the query API
PORT=8091

# PostgreSQL — the indexer owns its database (do NOT share the main app's DB).
# Option A (no Docker): a dedicated DB on your existing Postgres.
#   CREATE DATABASE debridge_indexer;
DATABASE_URL=postgres://crypto:crypto@localhost:5454/debridge_indexer
# Option B (Docker): the isolated Postgres from docker-compose.yml
#   DATABASE_URL=postgres://debridge:debridge@localhost:5456/debridge
DB_SYNC=true

# Forward crawler: poll the DLN stats API for new orders (ms). 0 disables.
CRAWL_ENABLED=true
CRAWL_INTERVAL_MS=120000

# Enrichment: fill sender/receiver + dest tx via the order-detail endpoint. 0 disables.
ENRICH_ENABLED=true
ENRICH_INTERVAL_MS=45000
ENRICH_BATCH=40
