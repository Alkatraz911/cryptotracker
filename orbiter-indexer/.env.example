# HTTP port for the query API
PORT=8088

# PostgreSQL — the indexer owns its database (do NOT share the main app's DB).
# Option A (no Docker): a dedicated DB on your existing Postgres.
#   CREATE DATABASE orbiter_indexer;
DATABASE_URL=postgres://crypto:crypto@localhost:5454/orbiter_indexer
# Option B (Docker): the isolated Postgres from docker-compose.yml
#   DATABASE_URL=postgres://orbiter:orbiter@localhost:5455/orbiter
# Auto-create / sync the orbiter_bridges table on boot.
DB_SYNC=true

# Forward crawler: poll Orbiter for new bridges on this interval (ms). 0 disables.
CRAWL_ENABLED=true
CRAWL_INTERVAL_MS=180000

# Address enrichment: backfill sender/receiver via the hash-lookup endpoint
# (covers ~last 6 months). 0 disables. Batch = rows per cycle.
ENRICH_ENABLED=true
ENRICH_INTERVAL_MS=60000
ENRICH_BATCH=40
